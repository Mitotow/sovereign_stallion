import pygame
from entities.projectile import Projectile
from core.camera import Camera
import core.constants as constants
from entities.base import AnimableEntity
from core.sprite.spritesheet import Spritesheet


def load_knight_animations():
    return {
        constants.IDLE: Spritesheet("assets/entities/enemies/test_knight/IDLE.png", 32, 32, 0.15, offset_y=constants.PLAYER_ANIM_OFFSET_Y),
        constants.WALK: Spritesheet("assets/entities/enemies/test_knight/WALK.png", 32, 32, 0.2, offset_y=constants.PLAYER_ANIM_OFFSET_Y),
    }

class Enemy(AnimableEntity):
    """Classe parente qui contient les fonctions communes"""

    def __init__(self, screen, position, size, animations, hitbox_size=constants.PLAYER_HB_SIZE):
        super().__init__(screen, position, size, constants.IDLE, animations, hitbox_size)
        self.screen = screen
        self.position = pygame.Vector2(position)
        self.velocity = pygame.Vector2(0, 0)
        self.gravity = 2000
        self.is_static = False
        self.is_grounded = False

    def apply_position(self):
        """Met à jour le rectangle et la hitbox"""
        self.rect.topleft = self.position
        self.hb.topleft = self.rect.topleft

    def draw(self, camera: Camera):
        """Affiche l'ennemi à l'écran (C'est cette fonction qui manquait !)"""
        self.screen.blit(self.image, camera.apply(self.rect))

class Archer(Enemy):
    def __init__(self, screen, position):
        super().__init__(screen, position, constants.PLAYER_SIZE, load_knight_animations())
        self.attack_timer = 0

    def update_animation(self):
        is_backward = self.velocity.x < 0
        if self.velocity.x != 0: self.facing_right = is_backward

        if abs(self.velocity.x) > 0:
            self.set_state(constants.WALK if not self.is_running else constants.RUN)
        else:
            self.set_state(constants.IDLE)
        self.animate()

    def update(self, dt, game):
        self.attack_timer += dt
        if not self.is_grounded:
            self.velocity.y += self.gravity * dt

        # Tir toutes les 2 secondes
        if self.attack_timer >= constants.ARCHER_ATTACK_TIMER:
            self.shoot(game)
            self.attack_timer = 0
            
        self.update_animation()

    def shoot(self, game):
        p_pos = pygame.Vector2(game.player.rect.center)
        e_pos = pygame.Vector2(self.rect.center)
        direction = (p_pos - e_pos)
        if direction.length() > 0:
            direction = direction.normalize()

        # On crée la flèche
        arrow = Projectile(self.screen, e_pos, direction * constants.ARCHER_PROJ_VELOCITY)
        game.projectiles.add(arrow)
        game.collision_system.add_dynamic(arrow)


class Knight(Enemy):
    def __init__(self, screen, position):
        super().__init__(screen, position, constants.PLAYER_SIZE, load_knight_animations())
        self.speed = 120
        
    def update_animation(self):
        is_backward = self.velocity.x < 0
        if self.velocity.x != 0: self.facing_right = is_backward

        if abs(self.velocity.x) > 0:
            self.set_state(constants.WALK if not self.is_running else constants.RUN)
        else:
            self.set_state(constants.IDLE)
        self.animate()

    def update(self, dt, game):
        if not self.is_grounded:
            self.velocity.y += self.gravity * dt

        # IA de poursuite
        dx = game.player.rect.centerx - self.rect.centerx
        if abs(dx) > 40:
            self.velocity.x = self.speed if dx > 0 else -self.speed
        else:
            self.velocity.x = 0
            
        self.update_animation()
